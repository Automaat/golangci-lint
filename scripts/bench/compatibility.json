{
  "schema_version": 1,
  "go_version": "go1.26.0",
  "concurrency": [1],
  "runs": 1,
  "workloads": [
    {
      "name": "directive-corpus",
      "url": "https://github.com/Automaat/golangci-lint.git",
      "revision": "2b3d9864a624c76500478b1bc7b0414cbf032f96",
      "modules": ["."]
    }
  ],
  "scenarios": [
    {
      "name": "diagnostic-config",
      "work_dir": "pkg/golinters/misspell",
      "packages": ["testdata/misspell.go"],
      "args": [
        "--default=none",
        "-Emisspell",
        "--config=testdata/misspell.yml"
      ]
    },
    {
      "name": "custom-config",
      "work_dir": "pkg/golinters/misspell",
      "packages": ["testdata/misspell_custom.go"],
      "args": [
        "--default=none",
        "-Emisspell",
        "--config=testdata/misspell_custom.yml"
      ]
    },
    {
      "name": "timeout",
      "mode": "timeout",
      "work_dir": "pkg/golinters/misspell",
      "packages": ["testdata/misspell.go"],
      "args": [
        "--no-config",
        "--default=none",
        "-Emisspell"
      ]
    },
    {
      "name": "cancellation",
      "mode": "cancel",
      "work_dir": "pkg/golinters/misspell",
      "packages": ["."],
      "args": [
        "--no-config",
        "--default=none",
        "-Emisspell"
      ]
    },
    {
      "name": "parallel-shared-cache",
      "mode": "parallel",
      "work_dir": "pkg/golinters/misspell",
      "packages": ["testdata/misspell.go"],
      "args": [
        "--default=none",
        "-Emisspell",
        "--config=testdata/misspell.yml"
      ]
    },
    {
      "name": "corrupted-cache",
      "mode": "corrupted-cache",
      "work_dir": "pkg/golinters/misspell",
      "packages": ["testdata/misspell.go"],
      "args": [
        "--default=none",
        "-Emisspell",
        "--config=testdata/misspell.yml"
      ]
    },
    {
      "name": "fix-mode",
      "work_dir": "test",
      "packages": ["testdata/fix/in/multiple-issues-fix.go"],
      "args": [
        "--default=none",
        "-Emisspell",
        "--config=testdata/configs/multiple-issues-fix.yml"
      ],
      "mutates": true,
      "expected_files": {
        "test/testdata/fix/in/multiple-issues-fix.go": "test/testdata/fix/out/multiple-issues-fix.go"
      }
    },
    {
      "name": "compile-error",
      "work_dir": "test",
      "packages": ["testdata/notcompiles/typecheck.go"],
      "args": [
        "--no-config",
        "--default=none",
        "-Emodernize"
      ]
    },
    {
      "name": "cgo",
      "work_dir": "pkg/golinters/unconvert",
      "packages": ["testdata/unconvert_cgo.go"],
      "args": [
        "--no-config",
        "--default=none",
        "-Eunconvert"
      ]
    },
    {
      "name": "path-exclusion",
      "work_dir": "test",
      "packages": ["testdata/path_except.go"],
      "args": [
        "--default=none",
        "-Eforbidigo",
        "--config=testdata/configs/path-except.yml"
      ]
    },
    {
      "name": "tests-enabled",
      "work_dir": "test",
      "packages": ["testdata/used_only_in_tests"],
      "args": [
        "--no-config",
        "--default=none",
        "-Eunused",
        "--tests=true"
      ]
    },
    {
      "name": "tests-disabled",
      "work_dir": "test",
      "packages": ["testdata/used_only_in_tests"],
      "args": [
        "--no-config",
        "--default=none",
        "-Eunused",
        "--tests=false"
      ]
    }
  ]
}
